  _levelsData:
  - _nameIllness: "\u0421\u0414\u0412\u0413"
    _indexScene: 1
    _sprite: {fileID: 21300000, guid: eede2bbf4252c9c4ebd6e2315abca794, type: 3}
    _story: "\u041D\u0438\u043A\u043E\u043B\u044F, 21 \u0433\u043E\u0434\n\r\n\u0410\u043D\u0430\u043C\u043D\u0435\u0437:\r\n\u0421
      \u0441\u0430\u043C\u043E\u0433\u043E \u0434\u0435\u0442\u0441\u0442\u0432\u0430
      \u041D\u0438\u043A\u043E\u043B\u044F \u0431\u044B\u043B \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C
      \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C. \u0415\u0433\u043E \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438
      \u0434\u043E\u043B\u0433\u043E \u043D\u0435 \u043C\u043E\u0433\u043B\u0438
      \u043F\u043E\u043D\u044F\u0442\u044C, \u043F\u043E\u0447\u0435\u043C\u0443
      \u043E\u043D \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u0442\u0435\u0440\u044F\u0435\u0442
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A\u043E \u0432\u0441\u0435\u043C\u0443,
      \u0447\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E
      \u0435\u0433\u043E \u0443\u0432\u043B\u0435\u043A\u0430\u043B\u043E. \u0412
      \u0448\u043A\u043E\u043B\u0435 \u044D\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u043E
      \u043A \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\u043C
      \u0441 \u0443\u0447\u0435\u0431\u043E\u0439: \u0423\u0447\u0438\u0442\u0435\u043B\u044F
      \u0436\u0430\u043B\u043E\u0432\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0435\u0433\u043E
      \u0440\u0430\u0441\u0441\u0435\u044F\u043D\u043D\u043E\u0441\u0442\u044C \u0438
      \u043D\u0435\u043F\u043E\u0441\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C.\u0427\u0435\u043C
      \u0431\u044B \u041D\u0438\u043A\u043E\u043B\u044F \u043D\u0435 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B
      \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0432 \u0436\u0438\u0437\u043D\u0438,
      \u043D\u0430 \u043A\u043E\u0433\u043E \u0431\u044B \u043D\u0435 \u0448\u0451\u043B
      \u0443\u0447\u0438\u0442\u044C\u0441\u044F,  \u0431\u0443\u0434\u044C \u0442\u043E
      - \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435,
      \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0430, \u0433\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D,
      \u043C\u0443\u0437\u044B\u043A\u0430, - \u0435\u043C\u0443 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u043B\u043E
      \u0443\u0441\u0438\u0434\u0447\u0438\u0432\u043E\u0441\u0442\u0438. \u041A
      20 \u0433\u043E\u0434\u0430\u043C \u043E\u043D \u043E\u0441\u043E\u0437\u043D\u0430\u043B,
      \u0447\u0442\u043E \u0435\u0433\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435
      \u0441\u043C\u0435\u043D\u044B \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432
      \u0438 \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0438\u0432\u043D\u044B\u0435
      \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0430.
      \u0412\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044F \u0441\u0432\u043E\u0438
      \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0438 \u0441 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u0435\u0439,
      \u043F\u0440\u043E\u043A\u0440\u0430\u0441\u0442\u0438\u043D\u0430\u0446\u0438\u044E
      \u0438 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
      \u043A\u0430\u0447\u0435\u043B\u0438, \u043E\u043D \u0440\u0435\u0448\u0438\u043B
      \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u0432 \u043F\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043A\u043B\u0438\u043D\u0438\u043A\u0443. \u0422\u0430\u043C \u0435\u043C\u0443
      \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u0421\u0414\u0412\u0413 \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u0442\u0435\u0440\u0430\u043F\u0438\u044E
      \u0438 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u044B.\n\r\n\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435:\r\n\u0421\u0438\u043D\u0434\u0440\u043E\u043C
      \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0430 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
      \u0438 \u0433\u0438\u043F\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
      (\u0421\u0414\u0412\u0413) \u2014 \u044D\u0442\u043E \u043D\u0435\u0432\u0440\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0438 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u0434\u0435\u0442\u0441\u043A\u043E\u043C
      \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 \u0438 \u043C\u043E\u0436\u0435\u0442
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0432\u043E
      \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0439 \u0436\u0438\u0437\u043D\u0438.
      \u041E\u043D\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0440\u0430\u0431\u043E\u0442\u044B \u043C\u043E\u0437\u0433\u0430, \u0432\u043B\u0438\u044F\u044E\u0449\u0438\u043C\u0438
      \u043D\u0430 \u0441\u0430\u043C\u043E\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C,
      \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
      \u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0430\u043C\u0438."
  - _nameIllness: "\u0411\u0438\u043F\u043E\u043B\u044F\u0440\u043D\u043E\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
      \u0438 \u0448\u0438\u0437\u043E\u0442\u0438\u043F\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E"
    _indexScene: 2
    _sprite: {fileID: 21300000, guid: ffcc83d7336af3b46a6c2733f69f53b0, type: 3}
    _story: "\r\u0411\u043E\u0433\u0434\u0430\u043D, 28 \u043B\u0435\u0442\n \r\n\u0410\u043D\u0430\u043C\u043D\u0435\u0437:\r\n\u041D\u0435\u043E\u043A\u043E\u043D\u0447\u0438\u043B
      \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0435 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435.\r\n\u0420\u0430\u0431\u043E\u0442\u0430\u043B
      \u043A\u0443\u0440\u044C\u0435\u0440\u043E\u043C, \u0431\u0430\u0440\u043C\u0435\u043D\u043E\u043C,
      \u0431\u0430\u0440\u0431\u0435\u0440\u043E\u043C, \u0444\u0438\u0442\u043D\u0435\u0441-\u0442\u0440\u0435\u043D\u0435\u0440\u043E\u043C.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u043D\u0430\u0447\u0438\u043D\u0430\u043B
      \u0441\u0432\u043E\u0435 \u0434\u0435\u043B\u043E, \u043D\u043E \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u043E.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u0438\u0441\u0447\u0435\u0437\u0430\u043B
      \u0438\u0437 \u0436\u0438\u0437\u043D\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
      \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u0435\u0433\u043E \u0438 \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E.\r\n\u0414\u043E
      \u043D\u0435\u0434\u0430\u0432\u043D\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0434\u0440\u0443\u0437\u044C\u044F \u0434\u0443\u043C\u0430\u043B\u0438,
      \u0447\u0442\u043E \u043E\u043D \u043A\u0430\u043A \u041A\u0430\u0440\u043B\u0441\u043E\u043D,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0436\u0438\u0432\u0435\u0442 \u043D\u0430
      \u043A\u0440\u044B\u0448\u0435, \u043F\u043E\u043A\u0430 \u0435\u0433\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438 \u043D\u0430
      \u043A\u0440\u044B\u0448\u0435 \u0432 \u043A\u0440\u0430\u0439\u043D\u0435
      \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
      \u0414\u0440\u0443\u0437\u044C\u044F \u0438 \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0438
      \u043D\u0430 \u0432\u0441\u044F\u043A\u0438\u0439 \u0441\u043B\u0443\u0447\u0430\u0439
      \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438 \u0411\u043E\u0433\u0434\u0430\u043D\u0430
      \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443 \u0441 \u043D\u0430\u0434\u0435\u0436\u0434\u043E\u0439,
      \u0447\u0442\u043E \u0435\u043C\u0443 \u0441\u043A\u043E\u0440\u043E \u0441\u0442\u0430\u043D\u0435\u0442
      \u043B\u0443\u0447\u0448\u0435. \u041F\u043E \u043D\u0430\u0447\u0430\u043B\u0443
      \u043E\u043D \u0443\u043F\u0438\u0440\u0430\u043B\u0441\u044F, \u043D\u0435
      \u0445\u043E\u0442\u0435\u043B \u0435\u0445\u0430\u0442\u044C, \u043D\u043E
      \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430\u043C
      \u0438 \u0432\u0440\u0430\u0447\u0430\u043C \u0441\u043A\u043E\u0440\u043E\u0439
      - \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0435\u0433\u043E \u0443\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043F\u043E\u043B\u0435\u0447\u0438\u0442\u044C\u0441\u044F.\n\r\n\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435:
      \u041F\u0435\u0440\u0435\u043C\u0435\u043D\u044B \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F
      \u043E\u0442 \u044D\u0439\u0444\u043E\u0440\u0438\u0438 (\u043C\u0430\u043D\u0438\u044F)
      \u0434\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0434\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u0438.
      \u0412 \u043C\u0430\u043D\u0438\u0430\u043A\u0430\u043B\u044C\u043D\u043E\u0439
      \u0444\u0430\u0437\u0435 \u2013 \u0433\u0438\u043F\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C,
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0438,
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u043D\u0430.
      \u0412 \u0434\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E\u0439
      \u2013 \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C, \u0430\u043F\u0430\u0442\u0438\u044F,
      \u0441\u0443\u0438\u0446\u0438\u0434\u0430\u043B\u044C\u043D\u044B\u0435 \u043C\u044B\u0441\u043B\u0438."
  - _nameIllness: "\u0422\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E"
    _indexScene: 3
    _sprite: {fileID: 21300000, guid: 68000ea19ef12744bba1eac85158b4db, type: 3}
    _story: "\u041B\u044E\u0441\u0438\u044F, 23 \u0433\u043E\u0434\u0430\n\r\r\n\u0410\u043D\u0430\u043C\u043D\u0435\u0437:\r\n\u0412
      \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 6 \u043B\u0435\u0442, \u0435\u0451
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u043D\u0430\u0447\u0430\u043B\u0438
      \u0447\u0430\u0441\u0442\u043E \u0441\u0441\u043E\u0440\u0438\u0442\u044C\u0441\u044F.
      \u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u0434\u043E\u043C\u0430
      \u0441\u0442\u0430\u043B\u0430 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u043D\u043E\u0439
      \u2013 \u041E\u0442\u0435\u0446 \u0435\u0451 \u0438\u0437\u0431\u0438\u0432\u0430\u043B,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u044B\u043F\u044C\u0435\u0442. \u0418
      \u0435\u0451 \u0438 \u043C\u0430\u043C\u0443. \u041B\u044E\u0441\u0438\u0435
      \u043D\u0435 \u0441 \u043A\u0435\u043C \u0431\u044B\u043B\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.
      \u041C\u0430\u0442\u044C \u043F\u043E-\u043D\u0430\u0447\u0430\u043B\u0443
      \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0435\u0451 \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C,
      \u043D\u043E \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
      \u0443 \u043C\u0430\u0442\u0435\u0440\u0438 \u043D\u0430\u0447\u0430\u043B\u0438\u0441\u044C
      \u043F\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0430\u0442\u0430\u043A\u0438
      \u0438 \u043E\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u0430  \u043F\u0438\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0433\u043B\u0443\u0448\u0438\u0442\u044C
      \u043F\u0430\u043D\u0438\u043A\u0443,  \u0438 \u043C\u0430\u0442\u044C \u0441
      \u043E\u0442\u0446\u043E\u043C \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
      \u0434\u0440\u0430\u043B\u0438\u0441\u044C, \u043F\u0435\u0440\u0435\u043F\u0430\u0434\u0430\u043B\u043E
      \u0438 \u041B\u044E\u0441\u0438\u0435. \u0415\u0439 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u0437\u0440\u043E\u0441\u043B\u0435\u0442\u044C.
      \u0412 16 \u043E\u043D\u0430 \u0443\u0436\u0435 \u0431\u044B\u043B\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0438 \u043D\u0438 \u043D\u0430 \u043A\u043E\u0433\u043E \u043D\u0435 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0430.
      \u041C\u0435\u0448\u0430\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0430\u0442\u0430\u043A\u0438 \u0415\u0451 \u0442\u043E\u0448\u043D\u0438\u043B\u043E,
      \u0433\u043E\u043B\u043E\u0432\u0430 \u043A\u0440\u0443\u0436\u0438\u043B\u0430\u0441\u044C.
      \u041F\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0433\u043E\u0440\u043E\u0434 \u0442\u043E\u0436\u0435 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433.
      \u041F\u0440\u0438 \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043A\u0435 \u043E\u043D\u0430 \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u0441\u043D\u043E\u0432\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439 \u0434\u0435\u0432\u043E\u0447\u043A\u043E\u0439,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0431\u043E\u044F\u043B\u0430\u0441\u044C,
      \u0447\u0442\u043E \u0437\u0430 \u043D\u0435\u0443\u0434\u0430\u0447\u0438
      \u0435\u0439 \u0431\u0443\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u043D\u043E.
      \u0415\u0439 \u043D\u0443\u0436\u0435\u043D \u0431\u044B\u043B \u0434\u0440\u0443\u0433,
      \u0441 \u043A\u0435\u043C \u043C\u043E\u0436\u043D\u043E \u044D\u0442\u0438\u043C
      \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F, \u043D\u043E
      \u0435\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E.\r\r\n\r\n\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435:\r\n\u0413\u0440\u0443\u043F\u043F\u0430
      \u043F\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0439,
      \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0435
      \u0438\u043B\u0438 \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u043E\u0435
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0442\u0440\u0435\u0432\u043E\u0433\u0438,
      \u0441\u0442\u0440\u0430\u0445\u0430 \u0438 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0430,
      \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E\u0439
      \u043F\u0440\u0438\u0447\u0438\u043D\u044B. \u042D\u0442\u0430 \u0442\u0440\u0435\u0432\u043E\u0433\u0430
      \u043C\u043E\u0436\u0435\u0442 \u043C\u0435\u0448\u0430\u0442\u044C \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438, \u0432\u044B\u0437\u044B\u0432\u0430\u044F
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u044B.\r"
  - _nameIllness: "\u041E\u0431\u0441\u0435\u0441\u0441\u0438\u0432\u043D\u043E-\u043A\u043E\u043C\u043F\u0443\u043B\u044C\u0441\u0438\u0432\u043D\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E "
    _indexScene: 4
    _sprite: {fileID: 21300000, guid: c922268014277d8419abcd49b5f11aef, type: 3}
    _story: "\u0410\u0440\u0442\u0451\u043C, 29 \u043B\u0435\u0442\n\r\n\u0410\u043D\u0430\u043C\u043D\u0435\u0437:\r\r\n\u041A
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u0433\u043E\u0434\u0430\u043C
      \u043F\u0430\u0446\u0438\u0435\u043D\u0442 \u043E\u0441\u043E\u0437\u043D\u0430\u043B,
      \u0447\u0442\u043E \u043E\u043D \u043C\u044B\u0441\u043B\u0438\u0442 \u043D\u0435
      \u0442\u0430\u043A, \u043A\u0430\u043A \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0435.
      \u041E\u043D, \u043C\u044F\u0433\u043A\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
      - \u043F\u0435\u0440\u0444\u0435\u043A\u0446\u0438\u043E\u043D\u0438\u0441\u0442
      \u0438 \u0442\u0435\u0440\u043F\u0435\u0442\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0447\u0442\u043E-\u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0432\u044B\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0431\u0449\u0435\u0439
      \u043A\u0430\u0440\u0442\u0438\u043D\u044B \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E.
      \u0411\u0443\u0434\u044C \u044D\u0442\u043E \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0443\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u043A\u0430
      \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u0440\u043E\u0432\u043D\u043E
      \u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u043D\u0430 \u0441\u0442\u043E\u043B\u0430\u0445
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B. \u0418 \u0435\u043C\u0443
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432\u0441\u0451
      \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C. \u0421\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043E\u043D \u0441\u0442\u0430\u043B
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043F\u0440\u043E \u0441\u0435\u0431\u044F
      \u0434\u043E \u0441\u0442\u0430 (\u0430 \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
      \u0438 \u0432\u0441\u043B\u0443\u0445) \u0438 \u0435\u043C\u0443 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E\u0441\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0433\u0447\u0435.
      \u041D\u043E, \u0435\u0441\u043B\u0438 \u0441\u0447\u0451\u0442 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0435\u043C\u0443 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043D\u0435\u0441\u0442\u0435\u0440\u043F\u0438\u043C\u043E \u043D\u0435\u0445\u043E\u0440\u043E\u0448\u043E.
      \u0418 \u043E\u043D \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0437\u0430\u043D\u043E\u0432\u043E. 
      \u041D\u043E \u0443 \u043D\u0435\u0433\u043E \u043C\u0435\u0447\u0442\u0430
      - \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u0451 \u0431\u044B\u043B\u043E
      \u0440\u043E\u0432\u043D\u043E \u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E.
      \r\n\u0412\u0435\u0434\u044C \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E, \u0447\u0442\u043E \u0432\u044B\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438\u0437 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0440\u0438\u0441\u0443\u043D\u043A\u0430
      (\u043C\u0438\u0440\u0430) - \u0435\u0433\u043E \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442.
      \n\r\n\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435: \r\n\u041E\u041A\u0420
      \u2014 \u044D\u0442\u043E \u0445\u0440\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435, \u043F\u0440\u0438
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0442 \u043D\u0435\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0435,
      \u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u044B\u0435 \u043C\u044B\u0441\u043B\u0438
      \u0438 \u0438\u0434\u0435\u0438, \u0432\u044B\u0437\u044B\u0432\u0430\u044E\u0449\u0438\u0435
      \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442, \u0438 \u043E\u043D
      \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C
      \u0440\u0438\u0442\u0443\u0430\u043B\u044B \u0438\u043B\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043E\u0431\u043B\u0435\u0433\u0447\u0438\u0442\u044C \u044D\u0442\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435.\r"
