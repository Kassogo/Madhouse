  m_Script: {fileID: 11500000, guid: 24e8fa8e5be198c419031922c3eca855, type: 3}
  m_Name: Nicolas
  m_EditorClassIdentifier: 
  _text:
  - "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u041D\u0438\u043A\u043E\u043B\u044F!
    \u041A\u0430\u043A \u0441\u0430\u043C\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435?"
  - ...
  - "\u041D\u0438\u043A\u043E\u043B\u044F! \u041A\u0430\u043A \u0441\u0430\u043C\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435?"
  - "\u0412\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E! \u0421\u043F\u0430\u0441\u0438\u0431\u043E,
    \u043C\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u0438\u0439!"
  - "\u041A\u043D\u0438\u0433\u0443 \u0447\u0438\u0442\u0430\u043B? \u041A\u0430\u043A
    \u0441 \u043D\u0435\u0443\u0441\u0438\u0434\u0447\u0438\u0432\u043E\u0441\u0442\u044C\u044E?"
  - "\u041F\u043B\u043E\u0445\u043E, \u043C\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u0438\u0439.
    \u0414\u043E\u043B\u044C\u0448\u0435 \u043F\u044F\u0442\u0438 \u043C\u0438\u043D\u0443\u0442
    \u0447\u0438\u0442\u0430\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u0443."
  - "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0447\u0438\u0442\u0430\u0442\u044C
    \u043F\u043E\u0434\u0445\u043E\u0434\u0430\u043C\u0438."
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0438\u0434\u0435\u044E,
    \u043C\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u0438\u0439!"
  - "\u0410 \u043A\u0430\u043A\u0438\u043C \u0442\u044B \u043C\u0435\u043D\u044F
    \u0432\u0438\u0434\u0438\u0448\u044C?"
  - "\u0412 \u0441\u043C\u044B\u0441\u043B\u0435, \u043C\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u0438\u0439?"
  - "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u0442\u0432\u043E\u0451 \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0435
    \u043C\u0438\u0440\u0430!"
  - "\u0412\u044B\u0441\u043E\u043A\u0438\u0439, \u0445\u0443\u0434\u043E\u0439,
    \u0432\u043E\u043B\u043E\u0441\u044B \u043F\u043E \u043F\u043B\u0435\u0447\u0438.
    \u0415\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0439 \u0432\u0438\u0434
    \u0432\u043D\u0435\u0448\u043D\u043E\u0441\u0442\u0438. \u0412\u0440\u043E\u0434\u0435
    \u0431\u044B, \u0445\u0440\u043E\u043C\u0430\u0435\u0442\u0435 \u043D\u0430 \u043F\u0440\u0430\u0432\u0443\u044E
    \u043D\u043E\u0433\u0443, \u0430 \u0447\u0442\u043E, \u043C\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u0438\u0439?"
  - "\u041D\u0438\u0447\u0435\u0433\u043E-\u043D\u0438\u0447\u0435\u0433\u043E. \u0414\u0430\u0432\u0430\u0439
    \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0438 \u0441\u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F..."
  _nameInterlocutor: "\u041D\u0438\u043A\u043E\u043B\u044F"
  _ourName: "\u0414\u043E\u043A\u0442\u043E\u0440"
  _portrait: {fileID: -1361951763, guid: 6a99ad01ec151ed4486c963c8268ba91, type: 3}
