  m_Script: {fileID: 11500000, guid: 24e8fa8e5be198c419031922c3eca855, type: 3}
  m_Name: Bogdan
  m_EditorClassIdentifier: 
  _text:
  - "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u0411\u043E\u0433\u0434\u0430\u043D!
    \u041A\u0430\u043A \u0441\u0430\u043C\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435?"
  - "\u041D\u0435 \u0434\u043E\u0431\u0440\u043E\u0435 \u043E\u043D\u043E \u043D\u0438
    \u0447\u0435\u0440\u0442\u0430, \u0431\u043B\u0438\u043D!"
  - "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
  - "\u041C\u043D\u0435 \u043D\u0435\u043A\u043E\u0433\u0434\u0430 \u0437\u0434\u0435\u0441\u044C
    \u043E\u0442\u0441\u0438\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F, \u0434\u0440\u0443\u0436\u0435!
    \u0410 \u043C\u0435\u043D\u044F \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044E\u0442,
    \u0431\u043B\u0438\u043D!"
  - "\u0418 \u043A\u0443\u0434\u0430 \u0436\u0435 \u043C\u044B \u0442\u0430\u043A
    \u0441\u043F\u0435\u0448\u0438\u043C?"
  - "\u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0440\u0435\u0448\u0451\u043D\u043D\u044B\u0435
    \u0434\u0435\u043B\u0430, \u0431\u043B\u0438\u043D!"
  - "\u041B\u0443\u0447\u0448\u0435 \u0441\u043A\u0430\u0436\u0438\u0442\u0435, \u043A\u0430\u043A\u0438\u043C
    \u0432\u044B \u043C\u0435\u043D\u044F \u0432\u0438\u0434\u0438\u0442\u0435?"
  - "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u043C\u0443\u0436\u0438\u043A \u043B\u0435\u0442
    \u0441\u043E\u0440\u043E\u043A\u0430. \u041B\u044B\u0441\u044B\u0439. \u0421\u043B\u0435\u0433\u043A\u0430
    \u0445\u0440\u043E\u043C\u0430\u0435\u0442\u0435 \u043D\u0430 \u043B\u0435\u0432\u0443\u044E
    \u043D\u043E\u0433\u0443. \u0420\u043E\u0441\u0442\u0430 \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E...
    \u0410 \u0447\u0442\u043E?"
  - "\u041D\u0438\u0447\u0435\u0433\u043E, \u043F\u0440\u043E\u0441\u0442\u043E,
    \u0441\u043F\u0430\u0441\u0438\u0431\u043E"
  - "\u0414\u0430, \u0431\u043B\u0438\u043D, \u044F \u0432\u043E\u043E\u0431\u0449\u0435
    \u0441\u043F\u0430\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u0443. \u0425\u043E\u0442\u044F
    \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u043F\u0430\u043B 16 \u0447\u0430\u0441\u043E\u0432
    \u0432 \u0434\u0435\u043D\u044C!"
  - "\u0415\u0449\u0451 \u0447\u0442\u043E?"
  - "\u0422\u043E \u0431\u0435\u043B\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u0430,
    \u0442\u043E \u0447\u0451\u0440\u043D\u0430\u044F!"
  - "\u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C!"
  _nameInterlocutor: "\u0411\u043E\u0433\u0434\u0430\u043D"
  _ourName: "\u0414\u043E\u043A\u0442\u043E\u0440"
  _portrait: {fileID: -1677639720, guid: 6a99ad01ec151ed4486c963c8268ba91, type: 3}
