  m_Script: {fileID: 11500000, guid: 24e8fa8e5be198c419031922c3eca855, type: 3}
  m_Name: Artem
  m_EditorClassIdentifier: 
  _text:
  - "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u0410\u0440\u0442\u0451\u043C"
  - "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u0414\u043E\u043A!"
  - "\u041A\u0430\u043A \u0441\u0430\u043C\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435?"
  - "\u0412\u0447\u0435\u0440\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
    \u0440\u0430\u0437 \u043F\u0435\u0440\u0435\u0441\u0442\u0438\u043B\u0430\u043B
    \u043A\u0440\u043E\u0432\u0430\u0442\u044C, \u0434\u043E\u043A! "
  - "\u041E\u043A. \u041A\u0430\u043A \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435?"
  - "\u0414\u043E\u043A, \u0443 \u0432\u0430\u0441 \u0433\u0430\u043B\u0441\u0442\u0443\u043A
    \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u0439 (\u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
    \u0433\u0430\u043B\u0441\u0442\u0443\u043A \u0434\u043E\u043A\u0442\u043E\u0440\u0443)"
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
  - "\u041A\u043E\u0433\u0434\u0430 \u0432\u044B\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0441\u044C,
    \u0434\u043E\u043A?"
  - "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430, \u043E\u0442\u0432\u0435\u0442\u044C
    \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441. \u041A\u0430\u043A\u0438\u043C
    \u0442\u044B \u043C\u0435\u043D\u044F \u0432\u0438\u0434\u0438\u0448\u044C?"
  - "\u0414\u043E\u043A, \u0442\u044B - \u043C\u0435\u0442\u0440 \u0441 \u043A\u0435\u043F\u043A\u043E\u0439,
    \u0441\u0442\u0440\u0438\u0436\u043A\u0430-\u0451\u0436\u0438\u043A. \u0428\u0440\u0430\u043C
    \u043D\u0430 \u0449\u0435\u043A\u0435. \u0412\u0441\u0435\u0433\u0434\u0430 \u0432
    \u043E\u0434\u043D\u043E\u043C \u0438 \u0442\u043E\u043C \u0436\u0435 \u0445\u0430\u043B\u0430\u0442\u0435
    - \u043D\u0430 \u043D\u0451\u043C \u043F\u044F\u0442\u043D\u044B\u0448\u043A\u043E."
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438,
    \u043A\u0430\u043A \u0442\u044B \u0441\u0435\u0431\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C?"
  - "\u0414\u043E\u043A, \u043F\u043E\u0434\u043E\u0436\u0434\u0438! \u0423 \u043C\u0435\u043D\u044F
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430!"
  - "\u0410 \u0443 \u043A\u043E\u0433\u043E \u0438\u0445 \u043D\u0435\u0442? \u0427\u0442\u043E
    \u0437\u0430 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430?"
  - "\u0414\u043E\u043A! \u041F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C \u043A\u0430\u043A
    \u044F \u0432\u044B\u0445\u043E\u0436\u0443 \u0438\u0437 \u043F\u0430\u043B\u0430\u0442\u044B
    \u2013 \u0443 \u043C\u0435\u043D\u044F \u0432\u0441\u0435 \u043C\u043E\u0438
    \u0436\u0443\u0447\u043A\u0438(\u0412 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u043E\u0439
    \u0441\u043C\u043E\u043B\u0435) \u043B\u0435\u0436\u0430\u0442 \u0440\u043E\u0432\u043D\u0435\u043D\u044C\u043A\u043E.
    \u0410 \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0441\u044C
    \u2013 \u043E\u0434\u0438\u043D \u043B\u0435\u0436\u0438\u0442 \u0432\u043D\u0435
    \u043F\u043E\u0440\u044F\u0434\u043A\u0430. \u0410 \u0438\u043D\u043E\u0433\u0434\u0430
    \u0434\u0430\u0436\u0435 \u0434\u0432\u0430!\r\n\u041C\u043E\u0436\u0435\u0442
    \u0431\u044B\u0442\u044C \u044D\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0438\u0437
    \u0441\u043E\u0441\u0435\u0434\u0435\u0439 \u0434\u0435\u043B\u0430\u0435\u0442?\r\n"
  - "\u041D\u0443-\u043A\u0430, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0439!"
  _nameInterlocutor: "\u0410\u0440\u0442\u0451\u043C"
  _ourName: "\u0414\u043E\u043A\u0442\u043E\u0440"
  _portrait: {fileID: -1953281130, guid: 6a99ad01ec151ed4486c963c8268ba91, type: 3}
