  m_Script: {fileID: 11500000, guid: b325192d13ca9054b91280b21ffe9e0a, type: 3}
  m_Name: FirstDialogy
  m_EditorClassIdentifier: 
  _text:
  - "\u042D\u042D\u042D... \u041D\u0435\u043B\u043E\u0432\u043A\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u0442\u044C\u0441\u044F
    \u0441\u0430\u043C\u043E\u043C\u0443 \u0441\u0435\u0431\u0435 \u0432 \u044D\u0442\u043E\u043C,
    \u043D\u043E \u044F \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E
    \u043A\u0442\u043E \u044F, \u0433\u0434\u0435 \u044F \u0438 \u0447\u0442\u043E
    \u044F \u0442\u0443\u0442 \u0434\u0435\u043B\u0430\u044E."
  - "\u041E\u0447\u0435\u043D\u044C \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430
    \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u0432\u0440\u0430\u0447\u0430, \u0430
    \u044F \u0432 \u0445\u0430\u043B\u0430\u0442\u0435 \u0434\u043E\u043A\u0442\u043E\u0440\u0430,
    \u043D\u043E \u0431\u043B\u0438\u043D, \u0430 \u0432\u0434\u0440\u0443\u0433
    \u044F \u043D\u0435 \u0434\u043E\u043A\u0442\u043E\u0440? "
  - "\u0422\u0430\u043A \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
    \u0447\u0442\u043E-\u0442\u043E \u0447\u0442\u043E \u043C\u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442
    \u043E \u0441\u0430\u043C\u043E\u043C \u0441\u0435\u0431\u0435. \u0422\u0430\u043A
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u0437\u0430\u043F\u043E\u0440\u043E\u043B\u0435\u043D. \r\n\u041A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u0442\u043E\u0436\u0435.\r\n"
  - "\u041D\u0443 \u043B\u0430\u0434\u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
    \u0431\u0443\u043C\u0430\u0436\u043A\u0438 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435
    \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0443\u0442? \r\n"
  - "\u041E, \u043A\u043D\u0438\u0433\u0438 \u043F\u043E \u043F\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0438.
    \u041A\u0430\u043A\u0438\u0435-\u0442\u043E \u0437\u0430\u043F\u0438\u0441\u043A\u0438
    \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435 \u043E \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430\u0445\u2026
    \u041E\u0433\u043E, \u044F \u0432 \u043F\u0441\u0438\u0445\u0443\u0448\u043A\u0435
    \u0447\u0442\u043E \u043B\u0438? \r\r\n"
  - "\u0410 \u0432\u0434\u0440\u0443\u0433 \u044F \u043D\u0435 \u0434\u043E\u043A\u0442\u043E\u0440,
    \u0430 \u043F\u0430\u0446\u0438\u0435\u043D\u0442?"
  - "\u0410 \u043C\u043E\u0433\u043B\u0438 \u043C\u043D\u0435 \u0447\u0442\u043E-\u0442\u043E
    \u0432\u043A\u043E\u043B\u043E\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u0443
    \u043C\u0435\u043D\u044F \u043F\u0430\u043C\u044F\u0442\u044C \u0441\u0442\u0451\u0440\u043B\u0430\u0441\u044C?"
  - "\u041B\u0430\u0434\u043D\u043E \u043F\u043E\u0434\u043E\u0436\u0434\u0443 \u043F\u043E\u043A\u0430
    \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442.
    \u0410 \u043F\u043E\u043A\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
    \u0431\u0443\u0434\u0443 \u0434\u0435\u043B\u0430\u0442\u044C."
